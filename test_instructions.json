{
  "schema_version": 1,
  "runner": "windows-latest",
  "commands": [
    {
      "name": "dependencies",
      "command": "python -m pip install -r requirements-dev.txt -r agent/requirements.txt && npm --prefix frontend install"
    },
    {
      "name": "regression_unit",
      "command": "python -m pytest -q tests/test_*.py"
    },
    {
      "name": "e2e",
      "command": "python -m pytest -q tests/e2e_cloud_headless.py tests/e2e_live_relay.py (requires RDP_BASE_URL)"
    },
    {
      "name": "stress",
      "command": "python -m pytest -q tests/test_v2_workflow_engine.py -k caps"
    },
    {
      "name": "security",
      "command": "gitleaks detect --source . --redact --verbose"
    },
    {
      "name": "fault_injection",
      "command": "python -m pytest -q tests/test_v2_fault_injection.py"
    }
  ]
}
