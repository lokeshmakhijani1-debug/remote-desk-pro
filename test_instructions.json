{
  "schema_version": 1,
  "runner": "ubuntu-latest",
  "commands": [
    {
      "name": "dependencies",
      "command": "python -m pip install --upgrade pip && python -m pip install -r requirements-dev.txt -r agent/requirements.txt && npm --prefix frontend install --no-audit --no-fund"
    },
    {
      "name": "compile",
      "command": "python -m compileall -q agent backend tests"
    },
    {
      "name": "unit_regression_privacy_and_10_environment_simulation",
      "command": "python -m pytest -q tests/test_*.py"
    },
    {
      "name": "frontend_build",
      "command": "npm --prefix frontend run build"
    },
    {
      "name": "mobile_remote_control_protocol",
      "command": "python -m pytest -q tests/test_input_dispatch.py tests/test_session_security.py tests/test_v2_fault_injection.py"
    },
    {
      "name": "live_e2e_optional",
      "command": "if [ -n \"$RDP_BASE_URL\" ]; then python -m pip install playwright && python -m playwright install --with-deps chromium && python tests/e2e_cloud_headless.py; else echo 'SKIP: configure RDP_BASE_URL to run live cloud E2E'; fi"
    },
    {
      "name": "recording_retention_and_storage",
      "command": "python -m pytest -q tests/test_session_recorder_settings.py"
    },
    {
      "name": "recording_control_security",
      "command": "python -m pytest -q tests/test_recording_control_security.py"
    },
    {
      "name": "stress",
      "command": "python -m pytest -q tests/test_v2_workflow_engine.py -k caps"
    },
    {
      "name": "fault_injection",
      "command": "python -m pytest -q tests/test_v2_fault_injection.py"
    },
    {
      "name": "security",
      "command": "gitleaks detect --source . --redact --verbose --log-opts=\"--all\""
    }
  ]
}
